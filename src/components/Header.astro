---
const base = import.meta.env.BASE_URL;
---
<header class="site-head">
  <div class="container head-row">
    <a class="brand" href={base} aria-label="MedVisual home">
      <svg viewBox="0 0 40 20" aria-hidden="true"><path d="M0 13 H9 L12 9 L15 13 H18 L20.5 2 L25 18.5 L28 13 H40" /></svg>
      <span>MedVisual</span>
    </a>
    <button class="search-trigger" type="button" data-search-open aria-label="Search MedVisual">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></svg>
      <span class="st-label">Search topics, subjects…</span>
      <kbd class="st-kbd">/</kbd>
    </button>
    <button class="btn icon-btn theme-btn" type="button" data-theme-toggle aria-label="Switch light or dark theme">
      <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
    </button>
  </div>
</header>

<div class="search-dialog" data-search-dialog hidden role="dialog" aria-modal="true" aria-label="Search">
  <div class="sd-backdrop" data-search-close></div>
  <div class="sd-panel">
    <div class="sd-bar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" /></svg>
      <input type="search" data-search-input placeholder="Search topics, subjects, terms…" autocomplete="off" spellcheck="false" aria-controls="sd-results" />
      <button class="btn sd-close" type="button" data-search-close>Close</button>
    </div>
    <div class="sd-results" id="sd-results" data-search-results role="listbox"></div>
    <p class="sd-foot"><span>↑ ↓ to move</span><span>Enter to open</span><span>Esc to close</span></p>
  </div>
</div>

<style is:global>
  .site-head { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--line); }
  .head-row { display: flex; align-items: center; gap: 12px; height: var(--header-h); }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 700 18px var(--font-display); letter-spacing: -0.02em; flex: none; }
  .brand svg { width: 36px; height: 18px; fill: none; stroke: var(--accent); stroke-width: 2.2; stroke-linejoin: round; stroke-linecap: round; }
  .search-trigger {
    flex: 1; max-width: 420px; margin-left: auto; display: flex; align-items: center; gap: 10px; height: 40px; padding: 0 10px 0 14px;
    border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); color: var(--muted); cursor: pointer; text-align: left; min-width: 0;
  }
  .search-trigger:hover { border-color: var(--fg); }
  .search-trigger svg, .sd-bar svg { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .st-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; }
  .st-kbd { font: 12px var(--font-mono); border: 1px solid var(--line-strong); border-radius: 6px; padding: 0 6px; }
  .theme-btn svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .theme-btn .i-moon { display: none; }
  :root[data-theme='dark'] .theme-btn .i-sun { display: none; }
  :root[data-theme='dark'] .theme-btn .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-btn .i-sun { display: none; }
    :root:not([data-theme='light']) .theme-btn .i-moon { display: block; }
  }
  @media (max-width: 520px) { .st-kbd { display: none; } .brand span { display: none; } }

  .search-dialog { position: fixed; inset: 0; z-index: 200; display: flex; justify-content: center; align-items: flex-start; padding: max(8vh, 16px) 12px 12px; }
  .sd-backdrop { position: absolute; inset: 0; background: rgb(8 12 18 / 0.5); backdrop-filter: blur(3px); }
  .sd-panel { position: relative; width: 100%; max-width: 640px; max-height: min(640px, 84vh); display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.5); overflow: hidden; }
  .sd-bar { display: flex; align-items: center; gap: 10px; padding: 10px 10px 10px 16px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .sd-bar input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font-size: 17px; color: var(--fg); height: 40px; }
  .sd-bar input::-webkit-search-cancel-button { display: none; }
  .sd-results { overflow-y: auto; padding: 8px; overscroll-behavior: contain; }
  .sd-group { font: 500 11px var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); padding: 10px 10px 4px; }
  .sd-item { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border-radius: 10px; text-decoration: none; }
  .sd-item[aria-selected='true'] { background: var(--accent-soft); }
  .sd-item b { font: 500 16px var(--font-display); }
  .sd-item small { color: var(--muted); font-size: 13px; }
  .sd-item .ex { color: var(--muted); font-size: 13px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .sd-item mark { background: color-mix(in srgb, var(--accent) 22%, transparent); color: inherit; border-radius: 3px; }
  .sd-tag { font: 500 10px var(--font-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--accent); }
  .sd-empty { padding: 24px 12px; color: var(--muted); text-align: center; }
  .sd-foot { display: flex; gap: 16px; padding: 8px 16px; border-top: 1px solid var(--line); font: 12px var(--font-mono); color: var(--muted); }
  @media (max-width: 600px) {
    .search-dialog { padding: 0; }
    .sd-panel { max-width: none; max-height: none; height: 100%; border-radius: 0; border: 0; }
    .sd-foot { display: none; }
  }
</style>

<script>
  import { initSearch } from '../scripts/search.js';
  import { initTheme } from '../scripts/theme.js';
  initSearch();
  initTheme();
</script>
